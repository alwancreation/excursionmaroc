<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>{{ app_settings.application_name|default('ExcursionMaroc') }}</title>
  </head>
  <body style="background-color: #f6f6f6; font-family: sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.4; margin: 0; padding: 0;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f6f6f6;">
      <tr>
        <td>&nbsp;</td>
        <td style="display: block; margin: 0 auto; max-width: 580px; width: 580px; padding: 10px;">
          <div style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 580px; padding: 10px;">
            <table style="width: 100%; background: #ffffff; border-radius: 3px;">
              <tr>
                <td style="padding: 24px;">
                  <h2 style="margin-top: 0; color: #d35400;">{{ app_settings.application_name|default('ExcursionMaroc') }}</h2>
                  {% block content %}{% endblock %}
                </td>
              </tr>
            </table>
            <div style="clear: both; margin-top: 10px; text-align: center; width: 100%;">
              <span style="color: #999999; font-size: 12px;">&copy; {{ "now"|date("Y") }} {{ app_settings.application_name|default('ExcursionMaroc') }}</span>
            </div>
          </div>
        </td>
        <td>&nbsp;</td>
      </tr>
    </table>
  </body>
</html>
