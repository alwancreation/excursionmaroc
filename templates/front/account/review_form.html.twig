{% extends 'front/base.html.twig' %}
{% form_theme form "bootstrap_3_layout.html.twig" %}
{% block body %}
    <div class="container">
        <ol class="breadcrumb">
            <li><a href="{{ url("homepage") }}">{% trans %}Home{% endtrans %}</a></li>
            <li><a href="{{ path('account_bookings') }}">{% trans %}My bookings{% endtrans %}</a></li>
            <li class="active">{% trans %}Leave a review{% endtrans %}</li>
        </ol>

        <h2>
            {% trans %}Review{% endtrans %}
            {% if booking.product %} : {{ booking.product.productName }}{% endif %}
        </h2>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="row">
            <div class="col-sm-6">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">{% trans %}Submit review{% endtrans %}</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
