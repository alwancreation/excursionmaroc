{% extends 'front/base.html.twig' %}
{% form_theme form "bootstrap_3_layout.html.twig" %}
{% block body %}
    <div class="container">
        <ol class="breadcrumb">
            <li><a href="{{ url("homepage") }}">{% trans %}Home{% endtrans %}</a></li>
            <li class="active">{% trans %}Sign up{% endtrans %}</li>
        </ol>
    </div>

    <div class="container">
        <h1>{% trans %}Create your account{% endtrans %}</h1>
        <div class="row">
            <div class="col-sm-6">
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}
                <div class="panel panel-default">
                    <div class="panel-body">
                        {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">{% trans %}Sign up{% endtrans %}</button>
                            </div>
                        {{ form_end(form) }}
                        <p><a href="{{ path('app_login') }}">{% trans %}Already have an account? Log in{% endtrans %}</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
