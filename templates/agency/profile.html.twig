{% extends 'admin/base.html.twig' %}
{% block page_title %}{% trans %}Agency profile{% endtrans %}{% endblock %}
{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-primary mt-5">{% trans %}Save{% endtrans %}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
