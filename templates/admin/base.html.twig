<!DOCTYPE html>
<html lang="fr">
<head>
    <title>{% block title %}{{ app_settings.application_name }}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <link rel="shortcut icon" href="{{ asset('assets/images/logo.png') }}" />

    {% block stylesheets %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:400,500,600,700" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="{{ asset('assets/css/custom-admin.css') }}" rel="stylesheet" />
    {% endblock %}
</head>
<body class="admin-body">

<div class="admin-sidebar" id="adminSidebar">
    <a class="admin-sidebar-logo" href="{{ path('admin_index') }}">
        <img src="{{ asset('assets/images/logo.png') }}" alt="Logo" />
        <span>{{ app_settings.application_agency_name|default('Admin') }}</span>
    </a>
    <nav class="admin-nav">
        <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_index' ? 'active' }}" href="{{ path('admin_index') }}">
            <i class="bi bi-speedometer2"></i> {% trans %}Dashboard{% endtrans %}
        </a>
        <a class="nav-link {{ 'booking' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('booking_index') }}">
            <i class="bi bi-calendar-check"></i> {% trans %}Bookings{% endtrans %}
        </a>
        <a class="nav-link {{ 'package' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('package_index') }}">
            <i class="bi bi-box-seam"></i> {% trans %}Packages{% endtrans %}
        </a>
        <a class="nav-link {{ 'product' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('product_index') }}">
            <i class="bi bi-bag"></i> {% trans %}Products{% endtrans %}
        </a>
        <a class="nav-link {{ 'client' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('client_index') }}">
            <i class="bi bi-people"></i> {% trans %}Clients{% endtrans %}
        </a>
        <a class="nav-link {{ 'category' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('category_index') }}">
            <i class="bi bi-tags"></i> {% trans %}Categories{% endtrans %}
        </a>
        <a class="nav-link {{ 'destination' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('destination_index') }}">
            <i class="bi bi-geo-alt"></i> {% trans %}Destinations{% endtrans %}
        </a>
        <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_excursion_pending' ? 'active' }}" href="{{ path('admin_excursion_pending') }}">
            <i class="bi bi-hourglass-split"></i> {% trans %}Excursions to review{% endtrans %}
        </a>
        <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_agency_index' ? 'active' }}" href="{{ path('admin_agency_index') }}">
            <i class="bi bi-building"></i> {% trans %}Agencies{% endtrans %}
        </a>
        <a class="nav-link {{ 'review' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('admin_review_index') }}">
            <i class="bi bi-star"></i> {% trans %}Reviews{% endtrans %}
        </a>
        <a class="nav-link {{ 'guides' in app.request.attributes.get('_route') ? 'active' }}" href="{{ path('guides_index') }}">
            <i class="bi bi-person-badge"></i> {% trans %}Guides{% endtrans %}
        </a>
        <a class="nav-link {{ app.request.attributes.get('_route') == 'users' ? 'active' }}" href="{{ path('users') }}">
            <i class="bi bi-person-lines-fill"></i> {% trans %}Users{% endtrans %}
        </a>

        <div class="nav-section-title">{% trans %}Configuration{% endtrans %}</div>
        <a class="nav-link {{ app.request.attributes.get('_route') == 'settings_index' ? 'active' }}" href="{{ path('settings_index') }}">
            <i class="bi bi-gear"></i> {% trans %}Application Settings{% endtrans %}
        </a>
        <a class="nav-link {{ app.request.attributes.get('_route') == 'agency_index' ? 'active' }}" href="{{ path('agency_index') }}">
            <i class="bi bi-briefcase"></i> {% trans %}Agency{% endtrans %}
        </a>
    </nav>
</div>

<div class="admin-main">
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="admin-sidebar-toggle" type="button" id="adminSidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <h1 class="h5 mb-0 fw-bold text-dark">{% block page_title %}{% endblock %}</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="{{ path('admin_index') }}" class="text-muted text-decoration-none">{% trans %}Home{% endtrans %}</a></li>
                        <li class="breadcrumb-item active">{% block page_sub_title %}{% endblock %}</li>
                    </ol>
                </nav>
            </div>
        </div>

        {% if app.user %}
        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-decoration-none text-dark dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle fs-4 me-2"></i>
                <span class="d-none d-md-inline">{{ app.user.email }}</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><span class="dropdown-item-text text-muted small">{{ app.user.mainRole }}</span></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>{% trans %}Sign Out{% endtrans %}</a></li>
            </ul>
        </div>
        {% endif %}
    </div>

    <div class="admin-content">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>

    <div class="admin-footer">
        &copy; {{ "now"|date("Y") }} {{ app_settings.application_agency_name }}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('adminSidebarToggle')?.addEventListener('click', function () {
        document.getElementById('adminSidebar').classList.toggle('show');
    });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
