<form method="post" action="{{ path('category_delete', {'id': category.categoryId}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.categoryId) }}">
    <button class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1">{% trans %}Delete{% endtrans %}</button>
</form>
