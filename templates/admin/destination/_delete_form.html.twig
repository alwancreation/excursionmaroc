<form method="post" action="{{ path('destination_delete', {'id': destination.destinationId}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ destination.destinationId) }}">
    <button class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1">{% trans %}Delete{% endtrans %}</button>
</form>
