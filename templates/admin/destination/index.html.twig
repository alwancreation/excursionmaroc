{% extends 'admin/base.html.twig' %}

{% block page_title %}{% trans %}Destinations{% endtrans %}{% endblock %}

{% block body %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}
<div class="row gy-5 g-xl-8">
    <div class="col-xxl-12">
        <div class="card card-xl-stretch mb-5 mb-xl-8">
            <div class="card-header">
                <h3 class="card-title fw-bolder text-dark">{% trans %}Destinations{% endtrans %}</h3>
                <div class="card-toolbar">
                    <a href="{{ path('destination_new') }}" class="btn btn-sm btn-primary">{% trans %}New{% endtrans %}</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-row-bordered table-row-gray-100 align-middle gs-0 gy-3">
                        <thead>
                            <tr>
                                <th>{% trans %}Name{% endtrans %}</th>
                                <th>{% trans %}Slug{% endtrans %}</th>
                                <th>{% trans %}Category{% endtrans %}</th>
                                <th class="text-end">{% trans %}Actions{% endtrans %}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for destination in destinations %}
                            <tr>
                                <td>{{ destination.destinationName }}</td>
                                <td>{{ destination.destinationSlug }}</td>
                                <td>{{ destination.destinationCategory }}</td>
                                <td class="text-end">
                                    <a href="{{ path('destination_edit', {'id': destination.destinationId}) }}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1">{% trans %}Edit{% endtrans %}</a>
                                    {{ include('admin/destination/_delete_form.html.twig') }}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4">{% trans %}No records found{% endtrans %}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
